{
    "version": 8,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "ninja-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "23",
                "CMAKE_CXX_STANDARD_REQUIRED": "ON",
                "CMAKE_CXX_EXTENSIONS": "OFF",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "BUILD_TESTING": "ON",
                "AXVP_BUILD_TESTS": "ON",
                "AXVP_BUILD_BENCH": "ON",
                "AXVP_EDGEARM": "OFF"
            }
        },
        {
            "name": "sanitize-base",
            "hidden": true,
            "inherits": "ninja-base",
            "cacheVariables": {
                "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
                "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
                "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined"
            }
        },
        {
            "name": "debug",
            "inherits": "ninja-base",
            "displayName": "Debug",
            "description": "Debug configuration for development work.",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "inherits": "ninja-base",
            "displayName": "Release",
            "description": "Optimized release configuration.",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "relwithdebinfo",
            "inherits": "ninja-base",
            "displayName": "RelWithDebInfo",
            "description": "Release-style build with debug information.",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "edgearm",
            "inherits": "ninja-base",
            "displayName": "EdgeARM",
            "description": "Cross-build configuration for ARM edge devices.",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "AXVP_EDGEARM": "ON"
            }
        },
        {
            "name": "lint",
            "inherits": "ninja-base",
            "displayName": "Lint",
            "description": "Clang-based configuration for static analysis.",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_COMPILER": "clang++",
                "AXVP_BUILD_TESTS": "OFF",
                "AXVP_BUILD_BENCH": "OFF",
                "AXVP_EDGEARM": "OFF"
            }
        },
        {
            "name": "asan",
            "inherits": "sanitize-base",
            "displayName": "ASan/UBSan",
            "description": "AddressSanitizer and UndefinedBehaviorSanitizer configuration.",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "tsan",
            "inherits": "ninja-base",
            "displayName": "TSan",
            "description": "ThreadSanitizer configuration.",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
                "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread",
                "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=thread"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "relwithdebinfo",
            "configurePreset": "relwithdebinfo"
        },
        {
            "name": "edgearm",
            "configurePreset": "edgearm"
        },
        {
            "name": "asan",
            "configurePreset": "asan"
        },
        {
            "name": "tsan",
            "configurePreset": "tsan"
        }
    ],
    "testPresets": [
        {
            "name": "debug",
            "configurePreset": "debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "release",
            "configurePreset": "release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "relwithdebinfo",
            "configurePreset": "relwithdebinfo",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "edgearm",
            "configurePreset": "edgearm",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "asan",
            "configurePreset": "asan",
            "output": {
                "outputOnFailure": true
            },
            "environment": {
                "LSAN_OPTIONS": "suppressions=${sourceDir}/cmake/lsan.supp",
                "AXVP_FORCE_CPU_BACKEND": "1"
            }
        },
        {
            "name": "tsan",
            "configurePreset": "tsan",
            "output": {
                "outputOnFailure": true
            },
            "environment": {
                "AXVP_FORCE_CPU_BACKEND": "1",
                "TSAN_OPTIONS": "ignore_noninstrumented_modules=1"
            }
        }
    ]
}
